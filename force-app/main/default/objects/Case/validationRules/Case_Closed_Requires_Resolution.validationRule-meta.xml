<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Case_Closed_Requires_Resolution</fullName>
    <active>true</active>
    <errorConditionFormula>ISPICKVAL(Status, "Closed") &amp;&amp; ISBLANK(Resolution__c)</errorConditionFormula>
    <errorDisplayField>Resolution__c</errorDisplayField>
    <errorMessage>Closed cases must include a resolution before saving.</errorMessage>
</ValidationRule>
