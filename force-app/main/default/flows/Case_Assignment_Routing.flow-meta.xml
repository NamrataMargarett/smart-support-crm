    <decisions>
        <name>Route_By_Category</name>
        <label>Route By Category</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Assign_General_Support</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other</defaultConnectorLabel>
        <rules>
            <name>Hardware_or_Software</name>
            <conditionLogic>OR</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hardware</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Software</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Technical_Support</targetReference>
            </connector>
            <label>Hardware or Software</label>
        </rules>
        <rules>
            <name>Billing_or_Refund</name>
            <conditionLogic>OR</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Refund</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Finance_Support</targetReference>
            </connector>
            <label>Billing or Refund</label>
        </rules>
        <rules>
            <name>Account_Category</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Account</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Account_Support</targetReference>
            </connector>
            <label>Account</label>
        </rules>
        <rules>
            <name>Shipping_Category</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Shipping</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Logistics_Support</targetReference>
            </connector>
            <label>Shipping</label>
        </rules>
    </decisions>
    <description>Route cases to support queues using business category rules.</description>
    <interviewLabel>Case Assignment Routing {!$Flow.CurrentDateTime}</interviewLabel>
