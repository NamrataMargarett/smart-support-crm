<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <assignments>
        <name>Set_Critical</name>
        <label>Set Critical</label>
        <locationX>200</locationX>
        <locationY>200</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Critical</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_High</name>
        <label>Set High</label>
        <locationX>200</locationX>
        <locationY>300</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Medium</name>
        <label>Set Medium</label>
        <locationX>200</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>$Record.Priority</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Medium</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Evaluate_Case_Priority</name>
        <label>Evaluate Case Priority</label>
        <locationX>200</locationX>
        <locationY>100</locationY>
        <defaultConnector>
            <targetReference>Set_Medium</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default</defaultConnectorLabel>
        <rules>
            <name>Premium_Hardware</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Premium</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hardware</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_High</targetReference>
            </connector>
            <label>Premium Hardware</label>
        </rules>
        <rules>
            <name>Enterprise_Hardware</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Enterprise</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Hardware</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Critical</targetReference>
            </connector>
            <label>Enterprise Hardware</label>
        </rules>
        <rules>
            <name>Billing_Category</name>
            <conditionLogic>AND</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_High</targetReference>
            </connector>
            <label>Billing Category</label>
        </rules>
    </decisions>
    <description>Record-triggered Flow to calculate Case priority while protecting manually selected Critical priority.</description>
    <interviewLabel>Case Priority Automation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case Priority Automation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>auto</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Case_Priority</name>
        <label>Update Case Priority</label>
        <locationX>200</locationX>
        <locationY>500</locationY>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Evaluate_Case_Priority</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
</Flow>
